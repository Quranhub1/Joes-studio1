# Joes Studio auth and billing environment

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for auth startup/config validation
USER_SESSION_SECRET=

# Admin console
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google OAuth 2.0 Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-API-HOST/api/auth?action=google-callback
APP_URL=https://YOUR-FRONTEND-HOST
API_ORIGIN=https://YOUR-API-HOST
FRONTEND_ORIGIN=https://YOUR-FRONTEND-HOST

# Plans and manual payment instructions
FREE_BATCH_LIMIT=3
PAYMENT_METHOD=Mobile Money
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_CURRENCY=UGX
PRO_PRICE=

# Optional session lifetime in seconds. Default: 30 days.
SESSION_TTL_SECONDS=2592000
